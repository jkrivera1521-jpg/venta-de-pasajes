{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://venta-pasajes.local/schemas/events/event-envelope.schema.json",
  "title": "VentaPasajesEventEnvelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "occurred_at",
    "source_service",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_service": {
      "type": "string",
      "enum": [
        "identity-service",
        "dispatch-service",
        "ticketing-service",
        "document-service",
        "reporting-service",
        "audit-service"
      ]
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "resource_type": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "resource_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

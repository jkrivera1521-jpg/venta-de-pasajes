# Common local development values.
# Copy only the variables needed by a local module. Do not store real secrets here.

APP_ENV=local
GOOGLE_CLOUD_PROJECT=venta-pasajes-dev
GOOGLE_CLOUD_REGION=us-central1

JWT_ISSUER=https://identity-service.local
JWT_AUDIENCE=venta-pasajes
JWT_PUBLIC_KEY_LOCATION=classpath:public-key.pem

LOG_LEVEL=INFO
OTEL_SERVICE_NAME=venta-pasajes-local

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_MFE_IDENTITY_MANIFEST_URL=http://localhost:3001/mfe/manifest
NEXT_PUBLIC_MFE_IDENTITY_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_MFE_IDENTITY_RECOVERY_URL=http://localhost:3001/identity/recovery
NEXT_PUBLIC_MFE_PUBLIC_URL=http://localhost:3001
NEXT_PUBLIC_SHELL_LOGIN_URL=http://localhost:3000/login
NEXT_PUBLIC_SHELL_APP_URL=http://localhost:3000/app

# report-service local. Descomenta este bloque solo al ejecutar ese servicio.
# La base se expone en el puerto 55438 del host y PostgreSQL usa 5432 dentro del contenedor.
# APP_ENV=local
# APP_RUNTIME_TARGET=local
# APP_DB_NAME=report_db
# APP_DB_JDBC_URL=jdbc:postgresql://localhost:55438/report_db
# APP_DB_USERNAME=report_user
# APP_DB_PASSWORD=ReportLocal_ChangeMe_12345
# QUARKUS_HTTP_PORT=8088
# QUARKUS_FLYWAY_MIGRATE_AT_START=true
# QUARKUS_FLYWAY_BASELINE_ON_MIGRATE=false
# APP_REPORT_STORAGE_PROVIDER=local
# APP_REPORT_STORAGE_LOCAL_DIR=target/report-storage
# APP_REPORT_PDF_ENABLED=true
# APP_REPORT_PARAMETERS_STRICT=true
# APP_JWT_SIGNING_SECRET=replace-with-a-local-secret-of-at-least-32-characters
# APP_JWT_ISSUER=identity-service
# APP_JWT_AUDIENCE=venta-pasajes

# Common local development values.
# Copy only the variables needed by a local module. Do not store real secrets here.

APP_ENV=local
GOOGLE_CLOUD_PROJECT=venta-pasajes-dev
GOOGLE_CLOUD_REGION=us-central1

JWT_ISSUER=https://identity-service.local
JWT_AUDIENCE=venta-pasajes
JWT_PUBLIC_KEY_LOCATION=classpath:public-key.pem

LOG_LEVEL=INFO
OTEL_SERVICE_NAME=venta-pasajes-local

NEXT_PUBLIC_APP_ENV=local
NEXT_PUBLIC_MFE_IDENTITY_MANIFEST_URL=http://localhost:3001/mfe/manifest
NEXT_PUBLIC_MFE_PUBLIC_URL=http://localhost:3001

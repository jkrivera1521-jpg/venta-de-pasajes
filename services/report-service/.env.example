# Configuracion local de report-service.
# Copia este archivo como .env local y reemplaza los valores sensibles.
# No uses estos valores fuera de desarrollo.

APP_ENV=local
APP_RUNTIME_TARGET=local

APP_DB_NAME=report_db
APP_DB_JDBC_URL=jdbc:postgresql://localhost:55438/report_db
APP_DB_USERNAME=report_user
APP_DB_PASSWORD=ReportLocal_ChangeMe_12345

QUARKUS_HTTP_PORT=8088
QUARKUS_FLYWAY_MIGRATE_AT_START=true
QUARKUS_FLYWAY_BASELINE_ON_MIGRATE=false

APP_REPORT_STORAGE_PROVIDER=local
APP_REPORT_STORAGE_LOCAL_DIR=target/report-storage
APP_REPORT_PDF_ENABLED=true
APP_REPORT_PARAMETERS_STRICT=true

# Solo para ejecutar localmente las rutas protegidas.
APP_JWT_SIGNING_SECRET=replace-with-a-local-secret-of-at-least-32-characters
APP_JWT_ISSUER=identity-service
APP_JWT_AUDIENCE=venta-pasajes

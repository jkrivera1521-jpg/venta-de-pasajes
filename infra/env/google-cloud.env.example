# Template for Google Cloud deployment values.

APP_ENV=dev
APP_RUNTIME_TARGET=gcp
APP_SECRETS_PROVIDER=google-secret-manager
GCLOUD_PATH=C:\ProgramData\chocolatey\lib\gcloudsdk\tools\google-cloud-sdk\bin\gcloud.cmd
CLOUDSDK_PYTHON=C:\Python312\python.exe
GOOGLE_CLOUD_PROJECT=venta-pasajes-dev
GOOGLE_CLOUD_PROJECT_NAME=Venta de Pasajes Dev
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_ORGANIZATION_ID=
GOOGLE_CLOUD_FOLDER_ID=
GOOGLE_BILLING_ACCOUNT_ID=000000-000000-000000
GOOGLE_BUDGET_AMOUNT=50
GOOGLE_BUDGET_CURRENCY=USD
GOOGLE_BUDGET_DISPLAY_NAME=venta-pasajes-dev-monthly-budget

ARTIFACT_REGISTRY_REPOSITORY=venta-pasajes-dev
CLOUD_SQL_INSTANCE_NAME=venta-pasajes-dev-sql
CLOUD_SQL_CONNECTION_NAME=venta-pasajes-dev:us-central1:venta-pasajes-dev-sql
CLOUD_SQL_DATABASE_VERSION=POSTGRES_16
CLOUD_SQL_TIER=db-f1-micro
CLOUD_SQL_IAM_AUTHENTICATION=true

IDENTITY_DB_NAME=identity_db
DISPATCH_DB_NAME=dispatch_db
TICKETING_DB_NAME=ticketing_db
DOCUMENTS_DB_NAME=documents_db
REPORTING_DB_NAME=reporting_db
AUDIT_DB_NAME=audit_db

IDENTITY_DB_IAM_USER=identity-service-run@venta-pasajes-dev.iam
DISPATCH_DB_IAM_USER=dispatch-service-run@venta-pasajes-dev.iam
TICKETING_DB_IAM_USER=ticketing-service-run@venta-pasajes-dev.iam
DOCUMENT_DB_IAM_USER=document-service-run@venta-pasajes-dev.iam
REPORTING_DB_IAM_USER=reporting-service-run@venta-pasajes-dev.iam
AUDIT_DB_IAM_USER=audit-service-run@venta-pasajes-dev.iam

DOCUMENTS_BUCKET=venta-pasajes-dev-documents
BACKUPS_BUCKET=venta-pasajes-dev-backups

IDENTITY_SERVICE_ACCOUNT=identity-service-run@venta-pasajes-dev.iam.gserviceaccount.com
DISPATCH_SERVICE_ACCOUNT=dispatch-service-run@venta-pasajes-dev.iam.gserviceaccount.com
TICKETING_SERVICE_ACCOUNT=ticketing-service-run@venta-pasajes-dev.iam.gserviceaccount.com
DOCUMENT_SERVICE_ACCOUNT=document-service-run@venta-pasajes-dev.iam.gserviceaccount.com
REPORTING_SERVICE_ACCOUNT=reporting-service-run@venta-pasajes-dev.iam.gserviceaccount.com
AUDIT_SERVICE_ACCOUNT=audit-service-run@venta-pasajes-dev.iam.gserviceaccount.com
FRONTEND_SHELL_SERVICE_ACCOUNT=frontend-shell-run@venta-pasajes-dev.iam.gserviceaccount.com
CLOUDBUILD_DEPLOYER_SERVICE_ACCOUNT=cloudbuild-deployer@venta-pasajes-dev.iam.gserviceaccount.com

IDENTITY_DB_CONNECTION_SECRET=identity-service__db-connection
DISPATCH_DB_CONNECTION_SECRET=dispatch-service__db-connection
TICKETING_DB_CONNECTION_SECRET=ticketing-service__db-connection
DOCUMENT_DB_CONNECTION_SECRET=document-service__db-connection
REPORTING_DB_CONNECTION_SECRET=reporting-service__db-connection
AUDIT_DB_CONNECTION_SECRET=audit-service__db-connection

IDENTITY_JWT_SIGNING_SECRET=identity-service__jwt-signing-secret
IDENTITY_REFRESH_TOKEN_PEPPER_SECRET=identity-service__refresh-token-pepper
IDENTITY_PASSWORD_PEPPER_SECRET=identity-service__password-pepper
IDENTITY_RECOVERY_TOKEN_PEPPER_SECRET=identity-service__recovery-token-pepper
FRONTEND_SESSION_SECRET=frontend-shell__session-secret

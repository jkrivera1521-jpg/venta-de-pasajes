# Google Cloud runtime example for identity-service.
# Secret values stay in Google Secret Manager, not in this file.

APP_ENV=dev
APP_RUNTIME_TARGET=gcp
APP_SECRETS_PROVIDER=google-secret-manager

QUARKUS_PROFILE=gcp
QUARKUS_HTTP_PORT=8081
QUARKUS_LOG_LEVEL=INFO
APP_LOG_CONSOLE_JSON=true

APP_DB_NAME=identity_db
APP_DB_JDBC_URL=jdbc:postgresql:///identity_db?cloudSqlInstance=project-fbb34cd7-0b82-43e1-867:us-central1:venta-pasajes-dev-sql&socketFactory=com.google.cloud.sql.postgres.SocketFactory&enableIamAuth=true&sslmode=disable
APP_DB_USERNAME=identity-service-run@project-fbb34cd7-0b82-43e1-867.iam
APP_DB_PASSWORD=
APP_DATABASE_SECRET_NAME=identity-service__db-connection

APP_JWT_SIGNING_SECRET_NAME=identity-service__jwt-signing-secret
APP_PASSWORD_PEPPER_SECRET_NAME=identity-service__password-pepper
APP_RECOVERY_TOKEN_PEPPER_SECRET_NAME=identity-service__recovery-token-pepper
APP_REFRESH_TOKEN_PEPPER_SECRET_NAME=identity-service__refresh-token-pepper

APP_JWT_ISSUER=https://identity-service-dev.example.com
APP_JWT_AUDIENCE=venta-pasajes
APP_JWT_ACCESS_TOKEN_TTL_SECONDS=3600

# These values should be injected by the deployment pipeline from Secret Manager.
APP_JWT_SIGNING_SECRET=<redacted>
APP_PASSWORD_PEPPER=<redacted>
APP_RECOVERY_TOKEN_PEPPER=<redacted>
APP_REFRESH_TOKEN_PEPPER=<redacted>

APP_AUTH_LOCAL_MAX_FAILED_ATTEMPTS=5
APP_AUTH_LOCAL_LOCKOUT_MINUTES=15
APP_AUTH_PASSWORD_PBKDF2_ITERATIONS=210000
APP_AUTH_RECOVERY_TOKEN_TTL_MINUTES=30
APP_AUTH_RECOVERY_RETURN_TOKEN_ENABLED=false

APP_GOOGLE_CLIENT_IDS=<google-oauth-client-id>
APP_GOOGLE_SIGNATURE_REQUIRED=true
APP_GOOGLE_DEV_TOKEN_ENABLED=false

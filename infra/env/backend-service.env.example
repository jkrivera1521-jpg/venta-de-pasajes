# Template for a Quarkus backend service.
# Copy to a real env file outside the repository or to a deployment secret store.

APP_ENV=local
APP_RUNTIME_TARGET=local
APP_SECRETS_PROVIDER=env
APP_SECRETS_LOCAL_FILE=

QUARKUS_PROFILE=
QUARKUS_HTTP_PORT=8080
QUARKUS_LOG_LEVEL=INFO
APP_LOG_CONSOLE_JSON=false

APP_DB_NAME=service_db
APP_DB_JDBC_URL=jdbc:postgresql://localhost:5432/service_db
APP_DB_USERNAME=service_user
APP_DB_PASSWORD=
APP_DATABASE_SECRET_NAME=<service>__db-connection

JWT_ISSUER=https://identity-service.local
JWT_AUDIENCE=venta-pasajes
JWT_PUBLIC_KEY_LOCATION=classpath:public-key.pem
JWT_SIGNING_SECRET_NAME=identity-service__jwt-signing-secret

GOOGLE_CLOUD_PROJECT=
PUBSUB_TOPIC=venta-pasajes-dev-service-events

OTEL_SERVICE_NAME=service-name
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Offline/on-premise runtime example for identity-service.
# Copy to a real file outside the repository, for example:
# C:\VENTA-DE-PASAJES-RUNTIME\identity-service.env

APP_ENV=onprem
APP_RUNTIME_TARGET=onprem
APP_SECRETS_PROVIDER=env
APP_SECRETS_LOCAL_FILE=

QUARKUS_PROFILE=onprem
QUARKUS_HTTP_PORT=8081
QUARKUS_LOG_LEVEL=INFO
APP_LOG_CONSOLE_JSON=false

APP_DB_NAME=identity_db
APP_DB_JDBC_URL=jdbc:postgresql://localhost:5432/identity_db
APP_DB_USERNAME=identity_user
APP_DB_PASSWORD=

APP_JWT_ISSUER=http://identity-service.onprem.local
APP_JWT_AUDIENCE=venta-pasajes
APP_JWT_ACCESS_TOKEN_TTL_SECONDS=3600

APP_JWT_SIGNING_SECRET=
APP_PASSWORD_PEPPER=
APP_RECOVERY_TOKEN_PEPPER=
APP_REFRESH_TOKEN_PEPPER=

APP_AUTH_LOCAL_MAX_FAILED_ATTEMPTS=5
APP_AUTH_LOCAL_LOCKOUT_MINUTES=15
APP_AUTH_PASSWORD_PBKDF2_ITERATIONS=210000
APP_AUTH_RECOVERY_TOKEN_TTL_MINUTES=10
APP_AUTH_RECOVERY_RETURN_TOKEN_ENABLED=false
APP_AUTH_RECOVERY_RESET_URL=http://localhost:3001/identity/recovery
APP_PUBLIC_DEFAULT_ROLE_CODE=CUSTOMER

# Password recovery email through Gmail API.
APP_GMAIL_ENABLED=false
APP_GMAIL_CLIENT_ID=
APP_GMAIL_CLIENT_SECRET=
APP_GMAIL_REFRESH_TOKEN=
APP_GMAIL_SENDER_EMAIL=

# Optional Google login. Offline/on-premise can run with local auth only.
APP_GOOGLE_CLIENT_IDS=local-google-client-placeholder
APP_GOOGLE_DEFAULT_ROLE_CODE=CUSTOMER
APP_GOOGLE_SIGNATURE_REQUIRED=true
APP_GOOGLE_DEV_TOKEN_ENABLED=false

# Optional first admin bootstrap. Fill only during first startup, then remove/disable.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_LOGIN=
APP_BOOTSTRAP_ADMIN_EMAIL=
APP_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrador
APP_BOOTSTRAP_ADMIN_PASSWORD=

{
  "environment": "prod",
  "default_project_id": "project-fbb34cd7-0b82-43e1-867",
  "default_region": "us-central1",
  "default_repository": "venta-pasajes-dev",
  "default_image_tag": "prod-backend-0.1.1-jvm",
  "default_cloud_sql_connection_name": "project-fbb34cd7-0b82-43e1-867:us-central1:venta-pasajes-prod-sql",
  "services": [
    {
      "id": "identity-service",
      "group": "backend",
      "service_name": "identity-service-prod",
      "image_name": "identity-service",
      "source_path": "services/identity-service",
      "port": 8081,
      "allow_unauthenticated": false,
      "service_account": "identity-prod-run@${PROJECT_ID}.iam.gserviceaccount.com",
      "cloud_sql": true,
      "cpu": "1",
      "memory": "512Mi",
      "min_instances": 0,
      "max_instances": 2,
      "health_path": "/api/v1/identity/health",
      "env": {
        "APP_ENV": "prod",
        "APP_RUNTIME_TARGET": "gcp",
        "APP_SECRETS_PROVIDER": "google-secret-manager",
        "GOOGLE_CLOUD_PROJECT": "${PROJECT_ID}",
        "QUARKUS_PROFILE": "gcp",
        "QUARKUS_HTTP_PORT": "8081",
        "CLOUD_SQL_CONNECTION_NAME": "${CLOUD_SQL_CONNECTION_NAME}",
        "APP_DB_JDBC_URL": "jdbc:postgresql:///identity_db?cloudSqlInstance=${CLOUD_SQL_CONNECTION_NAME}&socketFactory=com.google.cloud.sql.postgres.SocketFactory&enableIamAuth=true&sslmode=disable",
        "APP_DATABASE_SECRET_NAME": "identity-service-prod__db-connection",
        "APP_DB_USERNAME": "identity-prod-run@${PROJECT_ID}.iam",
        "QUARKUS_FLYWAY_MIGRATE_AT_START": "true",
        "QUARKUS_FLYWAY_BASELINE_ON_MIGRATE": "true",
        "APP_JWT_SIGNING_SECRET_NAME": "identity-service-prod__jwt-signing-secret",
        "APP_PASSWORD_PEPPER_SECRET_NAME": "identity-service-prod__password-pepper",
